Import('*')
PartName('am')

@build
def source(env):
    # a launcher with arguments and an env prefix whose quoted value has a
    # space in it reaches configure's CC= as one argument
    env['CC_LAUNCHER'] = 'env CCACHE_DIR="two words" ' + env.File('#launch.sh').abspath + ' --tag automake'
    # the configure here is hand written, so no autoreconf and no autotools
    env.AutoMake(autoreconf=None)
